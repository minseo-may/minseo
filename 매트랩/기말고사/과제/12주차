문제 4
%% Problem 4
clear; clc;

% (a), (b) wine.data 불러오기 및 변수명 지정
varNames = {'Class','Alcohol','MalicAcid','Ash',...
            'Alcalinity','Magnesium','Phenols',...
            'Flavanoids','Nonflavanoid',...
            'Proanthocyanins','ColorIntensity',...
            'Hue','OD280','Proline'};

Wine = readtable('wine.data', ...
    'FileType','text', ...
    'ReadVariableNames',false);

Wine.Properties.VariableNames = varNames;

% (c) 필요한 변수 선택
X = Wine{:, {'Alcohol','MalicAcid','ColorIntensity'}};

% (d) Z-score 방식 표준화 직접 구현
mu = mean(X);
sig = std(X);

X_std = (X - mu) ./ sig;

% (e) Euclidean norm 계산
normVec = sqrt(sum(X_std.^2, 2));

% (f) 90번째 백분위수 계산
cutoff = prctile(normVec, 90);

% (g) cutoff 이상인 행 추출
T_top = Wine(normVec >= cutoff, :);

% (h) 필요한 변수만 출력
T_top(:, {'Class','Alcohol','MalicAcid','ColorIntensity'})

문제 5
%% Problem 5
clear; clc;

% (a) 난수 seed 고정 및 데이터 생성
rng(0);

y = 50 + 5*randn(100,1);

% (b) 이상치 삽입
y(10) = 90;
y(25) = 95;
y(40) = 5;
y(70) = 100;
y(90) = 0;

% (c) 1사분위수, 3사분위수 계산
Q1 = quantile(y, 0.25);
Q3 = quantile(y, 0.75);

% (d) IQR 계산
IQR_val = Q3 - Q1;

% (e) 이상치 기준 범위 계산
lower = Q1 - 1.5 * IQR_val;
upper = Q3 + 1.5 * IQR_val;

% (f) 이상치 위치 저장
idx_outlier = (y < lower) | (y > upper);

% (g) 이상치 제거 및 중앙값 계산
y_clean = y(~idx_outlier);

med_clean = median(y_clean);

