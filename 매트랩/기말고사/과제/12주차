문제 1
%% Problem 1
clear; clc;

% (a) 원본 벡터 생성
x = [21, 22, NaN, 23, 24, 120, 25, NaN, 26, 27];

% (b) 결측치 위치 저장
idx_missing = isnan(x);

% 결측치를 제외한 평균과 표준편차 계산
validData = x(~idx_missing);

% (c) 평균과 표준편차 저장
mu0 = mean(validData);
sig0 = std(validData);

% (d) 평균에서 3σ를 초과한 값 찾기
lower = mu0 - 3*sig0;
upper = mu0 + 3*sig0;

idx_outlier = (x < lower) | (x > upper);

% (e) 결측치와 이상치를 NaN으로 변경
x_temp = x;

x_temp(idx_missing | idx_outlier) = NaN;

% (f) NaN 값을 평균으로 대체
fillValue = mean(x_temp(~isnan(x_temp)));

x_clean = x_temp;

x_clean(isnan(x_clean)) = fillValue;

% (g) 최종 평균과 표준편차
mu_clean = mean(x_clean);
sig_clean = std(x_clean);

% (h) 그래프 출력
figure;

plot(x,'-o','LineWidth',2);
hold on;

plot(x_clean,'-*','LineWidth',2);

legend('Original Data','Cleaned Data');

xlabel('Index');
ylabel('Temperature');

title('graph');

grid on;

문제 2
%% Problem 2
clear; clc;

% (a) 행렬 A 생성
A = [10 200 0.5;
     12 180 0.7;
     15 220 0.6;
     20 250 0.9;
     25 300 1.1];

% (b) 각 열의 최솟값과 최댓값 저장
colMin = min(A);

colMax = max(A);

% (c) Min-Max 정규화
A_norm = (A - colMin) ./ (colMax - colMin);

% (d) 각 행의 평균값 계산
rowMean = mean(A_norm, 2);

% (e) 평균이 가장 큰 행 번호 저장
[~, idx] = max(rowMean);

% (f) 원본 행과 정규화된 행 저장
bestOriginal = A(idx,:);

bestNormalized = A_norm(idx,:);

