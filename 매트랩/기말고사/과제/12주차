%% Problem 13
clear; clc;

% (a) x, y 정의 및 meshgrid 생성
x = -5:0.05:5;
y = -5:0.05:5;

[X, Y] = meshgrid(x, y);

% (b) 곡면 높이 계산
Z = exp(-0.08*(X.^2 + Y.^2)) ...
    .* sin(3*X) .* cos(2*Y) ...
    + 0.15*sin(X.*Y);

% (c) 3차원 곡면 그래프
figure;

surf(X, Y, Z);

% (d) shading 및 colorbar
shading interp;

colorbar;

hold on;

% (i) z = 0 기준면 추가
surf(X, Y, zeros(size(Z)), ...
    'FaceAlpha', 0.3, ...
    'EdgeColor', 'none');

% (e) 축 label 설정
xlabel('x-axis');

ylabel('y-axis');

zlabel('z=f(x,y)');

% (f) 제목 설정
title('Detailed Surface Plot of a Multivariable Function');

% (g) grid 및 글자 크기 설정
grid on;

set(gca, 'FontSize', 12);

% (h) 시점 설정
view(45,30);

% (j) 최대값과 최소값 계산
maxZ = max(Z(:));

minZ = min(Z(:));

% (k) 최대값 위치 찾기
[rowMax, colMax] = find(Z == maxZ);

[rowMin, colMin] = find(Z == minZ);

maxPoint = [X(rowMax(1), colMax(1)), ...
            Y(rowMax(1), colMax(1)), ...
            maxZ];

minPoint = [X(rowMin(1), colMin(1)), ...
            Y(rowMin(1), colMin(1)), ...
            minZ];

% (l) 최대점과 최소점 표시
plot3(maxPoint(1), maxPoint(2), maxPoint(3), ...
      'ro', 'MarkerSize', 10, 'LineWidth', 2);

plot3(minPoint(1), minPoint(2), minPoint(3), ...
      'bs', 'MarkerSize', 10, 'LineWidth', 2);

legend('Surface', ...
       'z=0 plane', ...
       'Maximum point', ...
       'Minimum point');

% (m) PNG 파일 저장
saveas(gcf, 'complex_surface.png');

