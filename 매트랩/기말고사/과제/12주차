문제 12
%% Problem 12
clear; clc;

% (a) 난수 seed 고정
rng(0);

% (b) t 생성
t = (1:120)';

% (c) signal 생성
signal = 30 + 4*sin(t/8) + randn(120,1);

% (d) 결측치 삽입
signal([15 45 90]) = NaN;

% (e) 이상치 삽입
signal(30) = 80;
signal(75) = -20;
signal(110) = 95;

% (f) 결측치 위치 및 개수 저장
idxMissing = isnan(signal);

numMissing = sum(idxMissing);

% (g) 결측치를 평균값으로 대체
fillValue = mean(signal(~idxMissing));

signalFilled = signal;

signalFilled(idxMissing) = fillValue;

% (h) 3σ 기준 이상치 탐지
mu = mean(signalFilled);
sig = std(signalFilled);

lower = mu - 3*sig;
upper = mu + 3*sig;

idxOutlier = (signalFilled < lower) | ...
             (signalFilled > upper);

% (i) 이상치를 NaN으로 변경
signalClean = signalFilled;

signalClean(idxOutlier) = NaN;

% (j) NaN이 아닌 값만 추출
validSignal = signalClean(~isnan(signalClean));

% (k) Min-Max 정규화
normSignal = (validSignal - min(validSignal)) ...
           / (max(validSignal) - min(validSignal));

% (l) 평균과 분산 계산
finalMean = mean(normSignal);

finalVar = var(normSignal);

% (m) 그래프 출력
figure;

tiledlayout(2,1);

nexttile;

plot(validSignal,'LineWidth',2);

title('Valid Signal');

grid on;

nexttile;

plot(normSignal,'LineWidth',2);

title('Normalized Signal');

grid on;

