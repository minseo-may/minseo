%% 문제 7

clc;
clear;

% (a)
arrivalInterval = exprnd(8,300,1);
arrivalTime = cumsum(arrivalInterval);

% (b)
serviceTime = 10 + 3*randn(300,1);
serviceTime(serviceTime < 0) = 1;

% (c)
startTime = zeros(300,1);
endTime = zeros(300,1);

startTime(1) = arrivalTime(1);
endTime(1) = startTime(1) + serviceTime(1);

for i = 2:300
    startTime(i) = max(arrivalTime(i),endTime(i-1));
    endTime(i) = startTime(i) + serviceTime(i);
end

% (d)
waitTime = startTime - arrivalTime;

% (e)
meanWait = mean(waitTime);
maxWait = max(waitTime);
ratio = sum(waitTime > 20)/length(waitTime);

fprintf('%.4f\n',meanWait);
fprintf('%.4f\n',maxWait);
fprintf('%.4f\n',ratio);

figure;
histogram(waitTime);
xlabel('x');
ylabel('y');
title('graph');

