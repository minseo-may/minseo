%% 문제 1

clc;
clear;

% (a) seed 고정
rng(13);

% (b) 40개 문항의 정답 확률 생성
p = 0.35 + (0.95 - 0.35) * rand(1,40);

% (c) 5000 × 40 logical matrix 생성
result = rand(5000,40) < p;

% (d) 총점, 평균점수, 표준편차 계산
score = sum(result,2);

meanScore = mean(score);
stdScore = std(score);

% (e) 점수 histogram
figure;
histogram(score);
xlabel('score');
ylabel('students');
title('graph');
grid on;

% 평균점수 이상 학생 비율
ratio = sum(score >= meanScore) / length(score);

%% 문제 2

clc;
clear;

% (a) 10000 × 20 크기의 제품 무게 행렬 생성
